{
  "version": "1.0",
  "description": "Default configuration values for MerchantDesk",
  "defaults": {
    "notificationsEnabled": true,
    "colorTheme": "default",
    "autoCapitalisation": true,
    "sendMessageKey": "enter",
    "spellCheck": false,
    "keepAwakeWhileRunning": false,
    "richToolDescriptions": true,
    "extendedPromptCache": false,
    "browserToolEnabled": true,
    "allowRemoteEvaluate": true
  },
  "workspaceDefaults": {
    "thinkingLevel": "think",
    "permissionMode": "ask",
    "cyclablePermissionModes": [
      "safe",
      "ask",
      "allow-all"
    ],
    "localMcpServers": {
      "enabled": true
    }
  }
}
